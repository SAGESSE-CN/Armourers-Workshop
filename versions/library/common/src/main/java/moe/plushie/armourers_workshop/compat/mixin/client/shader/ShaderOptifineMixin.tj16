package moe.plushie.armourers_workshop.compat.mixin.client.shader;

import moe.plushie.armourers_workshop.api.annotation.Available;
import moe.plushie.armourers_workshop.api.annotation.Conditional;
import moe.plushie.armourers_workshop.compat.client.AbstractClientHooks;
import moe.plushie.armourers_workshop.core.client.shader.Shader;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Pseudo;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.ModifyArg;

@Available("[16, 18)")
@Conditional("optifine")
@Pseudo
@Mixin(targets = "net.optifine.shaders.Shaders")
public class ShaderOptifineMixin {

    @ModifyArg(method = "createVertShader", at = @At(value = "INVOKE", target = "Lorg/lwjgl/opengl/ARBShaderObjects;glShaderSourceARB(ILjava/lang/CharSequence;)V"), remap = false)
    private static CharSequence aw2$compileVertexShader(int shader, CharSequence source) {
        AbstractClientHooks.createShaders();
        return Shader.patch((String) source, "optifine/vertex", 1);
    }

    @ModifyArg(method = "createGeomShader", at = @At(value = "INVOKE", target = "Lorg/lwjgl/opengl/ARBShaderObjects;glShaderSourceARB(ILjava/lang/CharSequence;)V"), remap = false)
    private static CharSequence aw2$compileGeometryShader(int shader, CharSequence source) {
        return Shader.patch((String) source, "optifine/geometry", 1);
    }

    @ModifyArg(method = "createFragShader", at = @At(value = "INVOKE", target = "Lorg/lwjgl/opengl/ARBShaderObjects;glShaderSourceARB(ILjava/lang/CharSequence;)V"), remap = false)
    private static CharSequence aw2$compileFragmentShader(int shader, CharSequence source) {
        return Shader.patch((String) source, "optifine/fragment", 1);
    }
}
